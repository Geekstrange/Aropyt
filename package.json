{
  "name": "aropyt",
  "version": "0.0.2",
  "private": true,
  "description": "跨平台 Markdown 编辑器 — Windows / macOS / Linux / Android，统一 Tauri 外壳",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @aropyt/web",
    "build": "npm run build -w @aropyt/web",
    "check:bundle": "node scripts/check-bundle.mjs apps/web/dist",
    "preview": "npm run preview -w @aropyt/web",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc -p packages/plugin-api && tsc -p packages/core && tsc -p packages/capabilities && tsc -p apps/web",
    "verify": "npm run typecheck && npm run check:render && npm run check:views && npm run check:icons && npm run build && npm run check:bundle && npm run check:commands   && npm run check:crash && npm run check:tabs && npm run check:editor-layout && npm run check:render-md",
    "check:views": "node scripts/check-view-activation.mjs",
    "check:render": "node scripts/check-inline-render.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:visual": "node scripts/verify-visual.mjs",
    "check:selection": "node scripts/check-selection.mjs",
    "shot": "node scripts/cdp-shot.mjs",
    "build:exe": "tauri build --no-bundle",
    "build:installer": "tauri build",
    "check:commands": "node scripts/check-commands.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "build:icons:toolbar": "node scripts/make-toolbar-icons.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:crash": "node scripts/check-crash-recovery.mjs",
    "check:tabs": "node scripts/check-tabs.mjs",
    "check:render-md": "node scripts/check-render-md.mjs",
    "check:editor-layout": "node scripts/check-layout-editor.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
