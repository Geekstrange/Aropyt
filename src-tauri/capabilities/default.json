{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Aropyt 桌面与 Android 壳的默认权限集。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:allow-open",
    "os:allow-platform",
    "os:allow-os-type",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "core:path:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.aropyt/**"
        },
        {
          "path": "$HOME/.aropyt"
        }
      ]
    },
    "fs:allow-exists",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.aropyt/**"
        }
      ]
    }
  ]
}
