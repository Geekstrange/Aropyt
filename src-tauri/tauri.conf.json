{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aropyt",
  "version": "0.0.6",
  "identifier": "dev.aropyt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aropyt",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' blob:; frame-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "跨平台 Markdown 编辑器",
    "longDescription": "Aropyt 是一款文件即真相的 Markdown 编辑器，支持 Windows、macOS、Linux 与 Android。",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": [
          "tex",
          "latex"
        ],
        "name": "LaTeX 文档",
        "description": "LaTeX 文档",
        "role": "Editor"
      },
      {
        "ext": [
          "fountain"
        ],
        "name": "Fountain 剧本",
        "description": "Fountain 剧本",
        "role": "Editor"
      }
    ],
    "resources": [
      "icons/files/*.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "endpoints": []
    }
  }
}
